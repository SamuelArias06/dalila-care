{
  "name": "dalila-care",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "build:api": "node scripts/build-api.mjs",
    "build:web": "npm run build -w @dalila/web",
    "dev": "npm run dev -w @dalila/web",
    "push:api": "npm run build:api && cd apps/api && clasp push --force",
    "build": "npm run build:api && npm run build:web",
    "setup": "node scripts/finish-setup.mjs"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.100",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
